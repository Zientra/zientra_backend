# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Controls which LLM the Debug Agent uses.
# Supported values: groq (default) | openai
AI_PROVIDER=groq

# ─── Groq - currently active ─────────────────────────────────────────────────
GROQ_API_KEY=

# ─── OpenAI - supported ───────────────────────────────────────────────────────
# To switch to OpenAI:
#   1. Set AI_PROVIDER=openai above
#   2. Fill in OPENAI_API_KEY below
OPENAI_API_KEY=

# ─── Workspace ────────────────────────────────────────────────────────────────
# Restricts the Debug Agent to a specific folder.
# Defaults to the directory node is started from (project root) if not set.
# WORKSPACE_ROOT=D:\Zientra\zientra_backend
